.message-conversations
  .message
    .message__container 
      %h2.message__title メッセージ
      - @conversations.each do |conversation|
        = link_to messages_path(id: conversation.partner(current_user)), class: "message__user-info", data: { turbo_frame: "messages" } do
          = image_tag conversation.partner(current_user).user_image.attached? ? url_for(conversation.partner(current_user).user_image) : "users/unknown.png", alt: "user-icon", class: "message__user-icon"
          .message__user-text
            %p.message__nickname= conversation.partner(current_user).nickname
            %p.message__context=  conversation.messages.last&.message || 'メッセージはありません'
            %time.message__date=  conversation.messages.last&.created_at&.strftime('%Y年%m月%d日')
  
  .user-message
    = turbo_frame_tag "messages", class: "user-message__container" do
      .messages-list{ id: "messages-list", data: { controller: "scroll" }}
        - @messages.each do |message|
          = render "message", message:

      .chat 
        = form_with model: Message.new, class: "chat-form" do |f|
          .chat-form__group 
            = f.text_field :message, class: "chat-form__input"
            = f.number_field :conversation_id, value: @conversation&.id, hidden: true 
            = f.submit "送信", class: "chat-form__btn"